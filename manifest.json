{
  "manifest_version": 3,
  "name": "Simple Block for X",
  "version": "1.0.0",
  "description": "X の投稿にワンクリックのブロックボタンを追加します",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
