{
  "manifest_version": 3,
  "name": "Simple Block",
  "version": "0.2.1",
  "description": "X の投稿にワンクリックのブロックボタンを追加します",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
